@model List<Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    var selected = ViewBag.SelectedStatus as OrderStatus?;
    string StatusText(OrderStatus s) => WebBanCameraGiamSat.Areas.Admin.Controllers.DashboardController.OrderStatusText(s);
}
<div class="page-banner">
    <div class="container">
        <h1>Đơn hàng của tôi</h1>
        <nav class="breadcrumb-nav"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <span>Đơn hàng của tôi</span></nav>
    </div>
</div>

<div class="container py-4">
    <div class="order-status-tabs">
        <a href="@Url.Action("History")" class="@(selected == null ? "active" : "")">Tất cả</a>
        <a href="@Url.Action("History", new { status = OrderStatus.ChoXacNhan })" class="@(selected == OrderStatus.ChoXacNhan ? "active" : "")">Chờ xác nhận</a>
        <a href="@Url.Action("History", new { status = OrderStatus.DangVanChuyen })" class="@(selected == OrderStatus.DangVanChuyen ? "active" : "")">Đang vận chuyển</a>
        <a href="@Url.Action("History", new { status = OrderStatus.DaGiaoHang })" class="@(selected == OrderStatus.DaGiaoHang ? "active" : "")">Đã giao hàng</a>
        <a href="@Url.Action("History", new { status = OrderStatus.DaHuy })" class="@(selected == OrderStatus.DaHuy ? "active" : "")">Đã hủy</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-bag-x"></i>
            <p>Bạn chưa có đơn hàng nào.</p>
            <a href="/san-pham" class="btn-primary-lg">Mua sắm ngay</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="order-history-card">
                <div class="order-history-header">
                    <div>
                        <strong>Mã đơn: @order.OrderCode</strong>
                        <span class="text-muted"> — @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <span class="order-status-badge status-@order.Status">@StatusText(order.Status)</span>
                </div>
                <div class="order-history-body">
                    @foreach (var d in order.OrderDetails.Take(3))
                    {
                        <div class="order-history-item">
                            <img src="@d.ProductImageUrl" alt="@d.ProductName" />
                            <span>@d.ProductName x@d.Quantity</span>
                        </div>
                    }
                    @if (order.OrderDetails.Count > 3)
                    {
                        <span class="text-muted">+@(order.OrderDetails.Count - 3) sản phẩm khác</span>
                    }
                </div>
                <div class="order-history-footer">
                    <span>Tổng tiền: <strong class="text-danger">@SlugHelper.FormatVnd(order.TotalAmount)</strong></span>
                    <a asp-action="Details" asp-route-id="@order.Id" class="btn-outline-sm">Xem chi tiết</a>
                </div>
            </div>
        }
    }
</div>
