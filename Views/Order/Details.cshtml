@model Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.OrderCode;
    string StatusText(OrderStatus s) => WebBanCameraGiamSat.Areas.Admin.Controllers.DashboardController.OrderStatusText(s);

    var steps = new[] { OrderStatus.ChoXacNhan, OrderStatus.DaXacNhan, OrderStatus.DangDongGoi, OrderStatus.DangVanChuyen, OrderStatus.DaGiaoHang };
    int currentStep = Array.IndexOf(steps, Model.Status);
}
<div class="page-banner">
    <div class="container">
        <h1>Chi tiết đơn hàng</h1>
        <nav class="breadcrumb-nav"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <a asp-action="History">Đơn hàng của tôi</a> <i class="bi bi-chevron-right"></i> <span>#@Model.OrderCode</span></nav>
    </div>
</div>

<div class="container py-4">
    @if (Model.Status != OrderStatus.DaHuy)
    {
        <div class="order-tracking-bar">
            @for (int i = 0; i < steps.Length; i++)
            {
                <div class="tracking-step @(i <= currentStep ? "done" : "")">
                    <div class="tracking-dot"><i class="bi bi-check-lg"></i></div>
                    <span>@StatusText(steps[i])</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-danger"><i class="bi bi-x-circle"></i> Đơn hàng này đã bị hủy.</div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="order-detail-card">
                <h5><i class="bi bi-box-seam"></i> Danh sách sản phẩm</h5>
                <table class="order-detail-table">
                    <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.OrderDetails)
                        {
                            <tr>
                                <td class="cart-product-cell">
                                    <img src="@d.ProductImageUrl" alt="@d.ProductName" />
                                    <span>@d.ProductName</span>
                                </td>
                                <td>@SlugHelper.FormatVnd(d.UnitPrice)</td>
                                <td>@d.Quantity</td>
                                <td>@SlugHelper.FormatVnd(d.SubTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="order-detail-card">
                <h5><i class="bi bi-geo-alt"></i> Thông tin giao hàng</h5>
                <p><strong>Người nhận:</strong> @Model.ReceiverName</p>
                <p><strong>Điện thoại:</strong> @Model.ReceiverPhone</p>
                <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <p><strong>Ghi chú:</strong> @Model.Note</p>
                }
            </div>
            <div class="order-detail-card">
                <h5><i class="bi bi-receipt"></i> Thanh toán</h5>
                <div class="cart-summary-row"><span>Tạm tính</span><span>@SlugHelper.FormatVnd(Model.SubTotal)</span></div>
                <div class="cart-summary-row"><span>Phí vận chuyển</span><span>@SlugHelper.FormatVnd(Model.ShippingFee)</span></div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="cart-summary-row"><span>Giảm giá (@Model.VoucherCode)</span><span class="text-danger">-@SlugHelper.FormatVnd(Model.DiscountAmount)</span></div>
                }
                <hr />
                <div class="cart-summary-row total-row"><span>Tổng cộng</span><span>@SlugHelper.FormatVnd(Model.TotalAmount)</span></div>
                <p class="mt-2"><strong>Phương thức:</strong> @Model.PaymentMethod</p>
                <p><strong>Trạng thái TT:</strong> @(Model.PaymentStatus == PaymentStatus.DaThanhToan ? "Đã thanh toán" : "Chưa thanh toán")</p>

                @if (Model.Status == OrderStatus.ChoXacNhan || Model.Status == OrderStatus.DaXacNhan)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng này?');">
                        <button type="submit" class="btn-outline-lg w-100 mt-2 text-danger">Hủy đơn hàng</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
