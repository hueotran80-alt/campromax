@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <h3>Đăng nhập tài khoản</h3>
    <p class="text-muted">Chào mừng bạn quay lại CamPro Security!</p>
    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="Nhập email của bạn" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Mật khẩu</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
        </div>
        <button type="submit" class="btn-primary-lg w-100">Đăng nhập</button>
    </form>
    <div class="auth-demo-hint">
        <p><i class="bi bi-info-circle"></i> Tài khoản demo:</p>
        <p>Quản trị: <code>admin@camprosecurity.vn</code> / <code>Admin@123</code></p>
        <p>Khách hàng: <code>khachhang@gmail.com</code> / <code>Khach@123</code></p>
    </div>
    <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
