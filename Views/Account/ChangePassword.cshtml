@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<div class="page-banner">
    <div class="container">
        <h1>Đổi mật khẩu</h1>
        <nav class="breadcrumb-nav"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <span>Đổi mật khẩu</span></nav>
    </div>
</div>
<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_AccountSidebar" />
        </div>
        <div class="col-lg-9">
            <div class="checkout-card">
                <h5><i class="bi bi-shield-lock"></i> Đổi mật khẩu</h5>
                <form asp-action="ChangePassword" method="post" style="max-width:500px;">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu hiện tại</label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu mới</label>
                        <input asp-for="NewPassword" type="password" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Xác nhận mật khẩu mới</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn-primary-lg">Cập nhật mật khẩu</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
