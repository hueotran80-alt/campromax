@model ProductListViewModel
@{
    ViewData["Title"] = "Sản phẩm";
    var selectedCategory = Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId);
}
<div class="page-banner">
    <div class="container">
        <h1>@(selectedCategory?.Name ?? (string.IsNullOrEmpty(Model.Keyword) ? "Tất cả sản phẩm" : $"Kết quả tìm kiếm: \"{Model.Keyword}\""))</h1>
        <nav class="breadcrumb-nav"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <span>Sản phẩm</span></nav>
    </div>
</div>

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="filter-sidebar">
                <h5><i class="bi bi-funnel-fill"></i> Bộ lọc sản phẩm</h5>

                <div class="filter-block">
                    <h6>Danh mục</h6>
                    <ul class="filter-list">
                        <li class="@(Model.SelectedCategoryId == null ? "active" : "")">
                            <a href="/san-pham">Tất cả danh mục</a>
                        </li>
                        @foreach (var c in Model.Categories)
                        {
                            <li class="@(Model.SelectedCategoryId == c.Id ? "active" : "")">
                                <a href="/danh-muc/@c.Slug">@c.Name</a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="filter-block">
                    <h6>Thương hiệu</h6>
                    <ul class="filter-list">
                        <li class="@(Model.SelectedBrandId == null ? "active" : "")">
                            <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, keyword = Model.Keyword })">Tất cả thương hiệu</a>
                        </li>
                        @foreach (var b in Model.Brands)
                        {
                            <li class="@(Model.SelectedBrandId == b.Id ? "active" : "")">
                                <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, brandId = b.Id, keyword = Model.Keyword })">@b.Name</a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="filter-block">
                    <h6>Khoảng giá</h6>
                    <form method="get" class="price-filter-form">
                        <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                        <input type="hidden" name="brandId" value="@Model.SelectedBrandId" />
                        <input type="hidden" name="keyword" value="@Model.Keyword" />
                        <div class="d-flex gap-2">
                            <input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Từ" value="@Model.MinPrice" />
                            <input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Đến" value="@Model.MaxPrice" />
                        </div>
                        <button type="submit" class="btn-filter-apply">Áp dụng</button>
                    </form>
                </div>

                <div class="filter-banner">
                    <i class="bi bi-headset"></i>
                    <p>Cần tư vấn chọn camera phù hợp?</p>
                    <a asp-controller="Home" asp-action="Contact">Liên hệ ngay</a>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="product-toolbar">
                <span class="result-count">Tìm thấy <strong>@Model.TotalItems</strong> sản phẩm</span>
                <div class="sort-options">
                    <label>Sắp xếp:</label>
                    <select id="sortSelect" onchange="location.href=this.value">
                        @{
                            string BuildUrl(string sort) => Url.Action("Index", new { categoryId = Model.SelectedCategoryId, brandId = Model.SelectedBrandId, keyword = Model.Keyword, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortBy = sort })!;
                        }
                        <option value="@BuildUrl("newest")" selected="@(Model.SortBy == "newest" || string.IsNullOrEmpty(Model.SortBy))">Mới nhất</option>
                        <option value="@BuildUrl("best-selling")" selected="@(Model.SortBy == "best-selling")">Bán chạy nhất</option>
                        <option value="@BuildUrl("price-asc")" selected="@(Model.SortBy == "price-asc")">Giá tăng dần</option>
                        <option value="@BuildUrl("price-desc")" selected="@(Model.SortBy == "price-desc")">Giá giảm dần</option>
                    </select>
                </div>
            </div>

            @if (Model.Products.Any())
            {
                <div class="product-grid">
                    @foreach (var p in Model.Products)
                    {
                        <partial name="_ProductCard" model="p" />
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination-wrap">
                        <ul class="pagination">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, brandId = Model.SelectedBrandId, keyword = Model.Keyword, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortBy = Model.SortBy, page = i })">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-search"></i>
                    <p>Không tìm thấy sản phẩm phù hợp.</p>
                    <a href="/san-pham" class="btn-primary-lg">Xem tất cả sản phẩm</a>
                </div>
            }
        </div>
    </div>
</div>
