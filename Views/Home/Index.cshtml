@{
    ViewData["Title"] = "Trang chủ";
    var banners = ViewBag.Banners as List<Banner> ?? new();
    var categories = ViewBag.Categories as List<Category> ?? new();
    var featured = ViewBag.FeaturedProducts as List<Product> ?? new();
    var bestSellers = ViewBag.BestSellers as List<Product> ?? new();
    var newProducts = ViewBag.NewProducts as List<Product> ?? new();
    var newsPosts = ViewBag.NewsPosts as List<NewsPost> ?? new();
    var brands = ViewBag.Brands as List<Brand> ?? new();
}

<!-- Hero banner slider -->
<section class="hero-section">
    <div class="container">
        <div class="hero-grid">
            <div class="hero-slider-wrap">
                @if (banners.Any())
                {
                    <div id="heroCarousel" class="carousel slide hero-carousel" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            @for (int i = 0; i < banners.Count; i++)
                            {
                                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                            }
                        </div>
                        <div class="carousel-inner">
                            @for (int i = 0; i < banners.Count; i++)
                            {
                                var b = banners[i];
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <a href="@(b.LinkUrl ?? "#")">
                                        <img src="@b.ImageUrl?v=20261006" alt="@b.Title" />
                                        <div class="hero-caption">
                                            <h2>@b.Title</h2>
                                            <p>@b.SubTitle</p>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </div>
                }
            </div>
            <div class="hero-side">
                <div class="hero-side-card">
                    <i class="bi bi-truck"></i>
                    <div><strong>Miễn phí vận chuyển</strong><span>Cho đơn hàng từ 300.000đ</span></div>
                </div>
                <div class="hero-side-card">
                    <i class="bi bi-shield-check"></i>
                    <div><strong>Bảo hành 24 tháng</strong><span>Chính hãng 100%</span></div>
                </div>
                <div class="hero-side-card">
                    <i class="bi bi-tools"></i>
                    <div><strong>Hỗ trợ lắp đặt</strong><span>Kỹ thuật viên tận nơi</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Danh muc noi bat -->
<section class="section category-section">
    <div class="container">
        <div class="category-grid">
            @foreach (var c in categories)
            {
                <a href="/danh-muc/@c.Slug" class="category-tile">
                    <div class="category-tile-icon"><i class="bi @(c.IconClass ?? "bi-camera-video")"></i></div>
                    <span>@c.Name</span>
                </a>
            }
        </div>
    </div>
</section>

<!-- San pham noi bat -->
@if (featured.Any())
{
    <section class="section">
        <div class="container">
            <div class="section-header">
                <h2><i class="bi bi-star-fill text-warning"></i> Sản phẩm nổi bật</h2>
                <a href="/san-pham" class="section-more">Xem tất cả <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="product-grid">
                @foreach (var p in featured)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>
        </div>
    </section>
}

<!-- Banner khuyen mai giua trang -->
<section class="section">
    <div class="container">
        <div class="mid-banner">
            <div class="mid-banner-text">
                <h3>Trả góp 0% lãi suất qua thẻ tín dụng</h3>
                <p>Áp dụng cho đơn hàng từ 3.000.000đ — Liên hệ hotline 0987 654 321 để được tư vấn.</p>
                <a asp-controller="Home" asp-action="Contact" class="btn-mid-banner">Liên hệ tư vấn</a>
            </div>
            <i class="bi bi-cash-stack mid-banner-icon"></i>
        </div>
    </div>
</section>

<!-- Ban chay nhat -->
@if (bestSellers.Any())
{
    <section class="section bg-light-section">
        <div class="container">
            <div class="section-header">
                <h2><i class="bi bi-fire text-danger"></i> Bán chạy nhất</h2>
                <a href="/san-pham?sortBy=best-selling" class="section-more">Xem tất cả <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="product-grid">
                @foreach (var p in bestSellers)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>
        </div>
    </section>
}

<!-- San pham moi -->
@if (newProducts.Any())
{
    <section class="section">
        <div class="container">
            <div class="section-header">
                <h2><i class="bi bi-lightning-charge-fill text-primary"></i> Sản phẩm mới</h2>
                <a href="/san-pham?sortBy=newest" class="section-more">Xem tất cả <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="product-grid">
                @foreach (var p in newProducts)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>
        </div>
    </section>
}

<!-- Video trai nghiem thuc te -->
<section class="section">
    <div class="container">
        <div class="card border-0 shadow-sm p-4 p-lg-5" style="border-radius: 16px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <div class="position-relative overflow-hidden shadow" style="border-radius: 12px; background: #000;">
                        <video controls poster="/images/banners/banner1.jpg" style="width: 100%; aspect-ratio: 16/9; display: block; object-fit: cover;" preload="metadata">
                            <source src="/videos/cctv-night-vision-demo.mp4" type="video/mp4" />
                            Trình duyệt không hỗ trợ xem video.
                        </video>
                    </div>
                </div>
                <div class="col-lg-5">
                    <span class="badge bg-danger px-3 py-2 text-uppercase fw-bold"><i class="bi bi-record-circle me-1"></i> Video ghi hình thực tế</span>
                    <h3 class="fw-bold mt-2 text-dark">Trải Nghiệm Khả Năng Giám Sát Ban Đêm 4K Siêu Nét</h3>
                    <p class="text-muted">Đoạn video kiểm thử trích xuất từ camera giám sát thông minh do CamPro phân phối. Hình ảnh thể hiện độ sắc nét, công nghệ lọc nhiễu 3D DNR và tầm nhìn ban đêm không độ trễ.</p>
                    <div class="d-flex flex-column gap-2 my-3 text-secondary">
                        <div class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-success"></i> <span>Ghi hình ban đêm rõ nét, tầm xa hồng ngoại 20-30m</span></div>
                        <div class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-success"></i> <span>Cảm biến phát hiện người và phương tiện thông minh AI</span></div>
                        <div class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-success"></i> <span>Xem trực tiếp và đàm thoại 2 chiều qua điện thoại 24/7</span></div>
                    </div>
                    <div>
                        <a href="/san-pham" class="btn btn-primary px-4 py-2 fw-semibold">Xem các mẫu camera <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Thuong hieu -->
@if (brands.Any())
{
    <section class="section bg-light-section">
        <div class="container">
            <div class="section-header">
                <h2><i class="bi bi-award-fill text-primary"></i> Thương hiệu phân phối</h2>
            </div>
            <div class="brand-strip">
                @foreach (var b in brands)
                {
                    <a href="/san-pham?brandId=@b.Id" class="brand-item" title="@b.Name">
                        <img src="@b.LogoUrl?v=20261006" alt="@b.Name" />
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- Tin tuc -->
@if (newsPosts.Any())
{
    <section class="section">
        <div class="container">
            <div class="section-header">
                <h2><i class="bi bi-newspaper text-primary"></i> Tin tức - Kiến thức camera</h2>
                <a asp-controller="News" asp-action="Index" class="section-more">Xem tất cả <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="news-grid">
                @foreach (var n in newsPosts)
                {
                    <a href="/tin-tuc/@n.Slug" class="news-card">
                        <img src="@n.ImageUrl?v=20261006" alt="@n.Title" />
                        <div class="news-card-body">
                            <span class="news-date"><i class="bi bi-calendar3"></i> @n.CreatedDate.ToString("dd/MM/yyyy")</span>
                            <h4>@n.Title</h4>
                            <p>@n.Summary</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}
