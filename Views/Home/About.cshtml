@{
    ViewData["Title"] = "Giới thiệu";
}
<div class="page-banner">
    <div class="container">
        <h1>Giới thiệu về CamPro Security</h1>
        <nav class="breadcrumb-nav"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <span>Giới thiệu</span></nav>
    </div>
</div>
<div class="container py-5">
    <div class="row g-4 align-items-center">
        <div class="col-md-6">
            <img src="/images/banners/about.jpg" class="img-fluid rounded shadow-sm" alt="Về chúng tôi" />
        </div>
        <div class="col-md-6">
            <h3 class="mb-3">CamPro Security - Giải pháp an ninh toàn diện</h3>
            <p>CamPro Security chuyên cung cấp và lắp đặt các giải pháp camera giám sát chính hãng từ những thương hiệu uy tín hàng đầu như Hikvision, Dahua, KBVision, Imou, EZVIZ, TP-Link Tapo...</p>
            <p>Với đội ngũ kỹ thuật viên giàu kinh nghiệm, chúng tôi cam kết mang đến giải pháp giám sát an ninh phù hợp cho từng nhu cầu: hộ gia đình, cửa hàng, văn phòng, nhà xưởng.</p>
            <ul class="about-list">
                <li><i class="bi bi-check-circle-fill"></i> Sản phẩm chính hãng, đầy đủ CO-CQ</li>
                <li><i class="bi bi-check-circle-fill"></i> Bảo hành chính hãng đến 24 tháng</li>
                <li><i class="bi bi-check-circle-fill"></i> Tư vấn giải pháp miễn phí</li>
                <li><i class="bi bi-check-circle-fill"></i> Hỗ trợ kỹ thuật 24/7</li>
            </ul>
        </div>
    </div>

    <div class="row g-4 mt-4 text-center">
        <div class="col-6 col-md-3">
            <div class="about-stat"><i class="bi bi-camera-video"></i><h3>500+</h3><p>Sản phẩm chính hãng</p></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="about-stat"><i class="bi bi-people"></i><h3>5.000+</h3><p>Khách hàng tin tưởng</p></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="about-stat"><i class="bi bi-building"></i><h3>10+</h3><p>Thương hiệu phân phối</p></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="about-stat"><i class="bi bi-award"></i><h3>24</h3><p>Tháng bảo hành</p></div>
        </div>
    </div>
</div>
