@model CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}
<div class="page-banner">
    <div class="container">
        <h1>Giỏ hàng của bạn</h1>
        <nav class="breadcrumb-nav"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <span>Giỏ hàng</span></nav>
    </div>
</div>

<div class="container py-4">
    @if (!Model.Items.Any())
    {
        <div class="empty-state">
            <i class="bi bi-cart-x"></i>
            <p>Giỏ hàng của bạn đang trống.</p>
            <a href="/san-pham" class="btn-primary-lg">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="cart-table-wrap">
                    <table class="cart-table" id="cartTable">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr data-cart-item-id="@item.CartItemId" data-unit-price="@item.UnitPrice">
                                    <td class="cart-product-cell">
                                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                                        <a href="/san-pham/@item.Slug">@item.ProductName</a>
                                    </td>
                                    <td>@SlugHelper.FormatVnd(item.UnitPrice)</td>
                                    <td>
                                        <div class="qty-input qty-input-sm">
                                            <button type="button" class="cart-qty-minus">-</button>
                                            <input type="number" class="cart-qty-input" value="@item.Quantity" min="1" max="@item.Stock" />
                                            <button type="button" class="cart-qty-plus">+</button>
                                        </div>
                                    </td>
                                    <td class="cart-line-total">@SlugHelper.FormatVnd(item.LineTotal)</td>
                                    <td><button type="button" class="btn-remove-cart-item"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <a href="/san-pham" class="continue-shopping-link"><i class="bi bi-arrow-left"></i> Tiếp tục mua sắm</a>
            </div>
            <div class="col-lg-4">
                <div class="cart-summary-card">
                    <h5>Tóm tắt đơn hàng</h5>
                    <div class="cart-summary-row">
                        <span>Tạm tính</span>
                        <span id="cartSubTotal">@SlugHelper.FormatVnd(Model.SubTotal)</span>
                    </div>
                    <div class="cart-summary-row">
                        <span>Tổng số lượng</span>
                        <span id="cartTotalQty">@Model.TotalQuantity sản phẩm</span>
                    </div>
                    <hr />
                    <a asp-controller="Checkout" asp-action="Index" class="btn-checkout"><i class="bi bi-bag-check"></i> Tiến hành thanh toán</a>
                </div>
            </div>
        </div>
    }
</div>
