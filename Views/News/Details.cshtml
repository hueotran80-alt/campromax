@model NewsPost
@{
    ViewData["Title"] = Model.Title;
    var others = ViewBag.OtherPosts as List<NewsPost> ?? new();
}
<div class="page-banner">
    <div class="container">
        <h1>@Model.Title</h1>
        <nav class="breadcrumb-nav"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <a asp-action="Index">Tin tức</a> <i class="bi bi-chevron-right"></i> <span>@Model.Title</span></nav>
    </div>
</div>
<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-8">
            <article class="news-detail-article">
                <img src="@Model.ImageUrl" class="news-detail-cover" alt="@Model.Title" />
                <div class="news-detail-meta">
                    <span><i class="bi bi-calendar3"></i> @Model.CreatedDate.ToString("dd/MM/yyyy")</span>
                    <span><i class="bi bi-eye"></i> @Model.ViewCount lượt xem</span>
                </div>
                <div class="news-detail-content">
                    @Html.Raw(Model.Content)
                </div>
            </article>
        </div>
        <div class="col-lg-4">
            <div class="news-sidebar-card">
                <h5>Bài viết khác</h5>
                @foreach (var n in others)
                {
                    <a href="/tin-tuc/@n.Slug" class="news-sidebar-item">
                        <img src="@n.ImageUrl" alt="@n.Title" />
                        <div>
                            <span>@n.Title</span>
                            <small>@n.CreatedDate.ToString("dd/MM/yyyy")</small>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
