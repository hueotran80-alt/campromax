@model List<NewsPost>
@{
    ViewData["Title"] = "Tin tức - Kiến thức";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}
<div class="page-banner">
    <div class="container">
        <h1>Tin tức - Kiến thức camera</h1>
        <nav class="breadcrumb-nav"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <span>Tin tức</span></nav>
    </div>
</div>
<div class="container py-4">
    <div class="news-grid">
        @foreach (var n in Model)
        {
            <a href="/tin-tuc/@n.Slug" class="news-card">
                <img src="@n.ImageUrl" alt="@n.Title" />
                <div class="news-card-body">
                    <span class="news-date"><i class="bi bi-calendar3"></i> @n.CreatedDate.ToString("dd/MM/yyyy")</span>
                    <h4>@n.Title</h4>
                    <p>@n.Summary</p>
                </div>
            </a>
        }
    </div>
    @if (totalPages > 1)
    {
        <nav class="pagination-wrap">
            <ul class="pagination">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
