@model List<WishlistItem>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}
<div class="page-banner">
    <div class="container">
        <h1>Sản phẩm yêu thích</h1>
        <nav class="breadcrumb-nav"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <span>Yêu thích</span></nav>
    </div>
</div>
<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_AccountSidebar" />
        </div>
        <div class="col-lg-9">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-heart"></i>
                    <p>Bạn chưa có sản phẩm yêu thích nào.</p>
                    <a href="/san-pham" class="btn-primary-lg">Khám phá sản phẩm</a>
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var w in Model)
                    {
                        if (w.Product != null)
                        {
                            <partial name="_ProductCard" model="w.Product" />
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>
