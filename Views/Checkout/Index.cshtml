@model CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
}
<div class="page-banner">
    <div class="container">
        <h1>Thanh toán đơn hàng</h1>
        <nav class="breadcrumb-nav"><a href="/">Trang chủ</a> <i class="bi bi-chevron-right"></i> <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a> <i class="bi bi-chevron-right"></i> <span>Thanh toán</span></nav>
    </div>
</div>

<div class="container py-4">
    <form asp-controller="Checkout" asp-action="PlaceOrder" method="post" id="checkoutForm">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="checkout-card">
                    <h5><i class="bi bi-truck"></i> Thông tin giao hàng</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Họ tên người nhận</label>
                            <input name="ReceiverName" class="form-control" value="@Model.ReceiverName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>
                            <input name="ReceiverPhone" class="form-control" value="@Model.ReceiverPhone" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Địa chỉ giao hàng</label>
                            <textarea name="ShippingAddress" class="form-control" rows="2" required>@Model.ShippingAddress</textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Ghi chú (tùy chọn)</label>
                            <textarea name="Note" class="form-control" rows="2" placeholder="Ví dụ: Giao ngoài giờ hành chính..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="checkout-card">
                    <h5><i class="bi bi-credit-card"></i> Phương thức thanh toán</h5>
                    <div class="payment-method-list">
                        <label class="payment-method-item">
                            <input type="radio" name="PaymentMethod" value="@((int)PaymentMethod.COD)" checked />
                            <div class="payment-method-content">
                                <i class="bi bi-cash-coin"></i>
                                <div><strong>Thanh toán khi nhận hàng (COD)</strong><span>Thanh toán bằng tiền mặt khi nhận hàng</span></div>
                            </div>
                        </label>
                        <label class="payment-method-item">
                            <input type="radio" name="PaymentMethod" value="@((int)PaymentMethod.VNPay)" />
                            <div class="payment-method-content">
                                <i class="bi bi-credit-card-2-front"></i>
                                <div><strong>VNPay</strong><span>Thanh toán qua cổng VNPay (ATM/Visa/Master/QR)</span></div>
                            </div>
                        </label>
                        <label class="payment-method-item">
                            <input type="radio" name="PaymentMethod" value="@((int)PaymentMethod.MoMo)" />
                            <div class="payment-method-content">
                                <i class="bi bi-wallet2"></i>
                                <div><strong>Ví MoMo</strong><span>Quét mã QR thanh toán qua ví MoMo (demo)</span></div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="checkout-summary-card">
                    <h5><i class="bi bi-receipt"></i> Đơn hàng của bạn</h5>
                    <div class="checkout-items">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="checkout-item-row">
                                <img src="@item.ImageUrl" alt="@item.ProductName" />
                                <div class="checkout-item-info">
                                    <span class="checkout-item-name">@item.ProductName</span>
                                    <span class="checkout-item-qty">x@item.Quantity</span>
                                </div>
                                <span class="checkout-item-price">@SlugHelper.FormatVnd(item.LineTotal)</span>
                            </div>
                        }
                    </div>

                    <div class="voucher-apply-box">
                        <input type="text" id="voucherCodeInput" name="VoucherCode" class="form-control" placeholder="Nhập mã giảm giá (VD: FREESHIP)" />
                        <button type="button" id="btnApplyVoucher" class="btn-apply-voucher">Áp dụng</button>
                    </div>
                    <div id="voucherMessage" class="voucher-message"></div>

                    <div class="checkout-summary-totals">
                        <div class="cart-summary-row"><span>Tạm tính</span><span id="sumSubTotal">@SlugHelper.FormatVnd(Model.Cart.SubTotal)</span></div>
                        <div class="cart-summary-row"><span>Phí vận chuyển</span><span id="sumShipping">@SlugHelper.FormatVnd(Model.ShippingFee)</span></div>
                        <div class="cart-summary-row" id="sumDiscountRow" style="display:none;"><span>Giảm giá</span><span id="sumDiscount" class="text-danger">-0đ</span></div>
                        <hr />
                        <div class="cart-summary-row total-row"><span>Tổng cộng</span><span id="sumTotal">@SlugHelper.FormatVnd(Model.TotalAmount)</span></div>
                    </div>

                    <button type="submit" class="btn-place-order"><i class="bi bi-check-circle"></i> Đặt hàng ngay</button>
                    <p class="checkout-agree-text">Bằng việc nhấn "Đặt hàng ngay", bạn đồng ý với <a asp-controller="Home" asp-action="Policy">điều khoản và chính sách</a> của CamPro Security.</p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    document.getElementById('btnApplyVoucher').addEventListener('click', function () {
        var code = document.getElementById('voucherCodeInput').value.trim();
        if (!code) return;
        fetch('/Checkout/ApplyVoucher', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getCsrfToken() },
            body: 'code=' + encodeURIComponent(code)
        }).then(r => r.json()).then(data => {
            var msgBox = document.getElementById('voucherMessage');
            if (data.success) {
                msgBox.className = 'voucher-message text-success';
                msgBox.innerText = data.message;
                document.getElementById('sumDiscountRow').style.display = 'flex';
                document.getElementById('sumDiscount').innerText = '-' + formatVnd(data.discount);
                document.getElementById('sumTotal').innerText = formatVnd(data.total);
            } else {
                msgBox.className = 'voucher-message text-danger';
                msgBox.innerText = data.message;
                document.getElementById('sumDiscountRow').style.display = 'none';
            }
        });
    });
</script>
}
