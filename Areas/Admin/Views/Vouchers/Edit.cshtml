@model Voucher
@{ ViewData["Title"] = "Sửa voucher"; }
<div class="admin-card" style="max-width:700px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Code" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label class="form-label">Mã voucher</label><input value="@Model.Code" class="form-control" disabled /></div>
        <div class="mb-3"><label class="form-label">Mô tả</label><input asp-for="Description" class="form-control" /></div>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Loại giảm giá</label>
                <select asp-for="Type" class="form-select">
                    <option value="0">Phần trăm (%)</option>
                    <option value="1">Số tiền cố định</option>
                </select>
            </div>
            <div class="col-md-6"><label class="form-label">Giá trị giảm</label><input asp-for="Value" type="number" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">Đơn tối thiểu (VNĐ)</label><input asp-for="MinOrderAmount" type="number" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">Giảm tối đa (VNĐ)</label><input asp-for="MaxDiscountAmount" type="number" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label">Ngày bắt đầu</label><input asp-for="StartDate" type="date" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label">Ngày kết thúc</label><input asp-for="EndDate" type="date" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label">Giới hạn lượt dùng</label><input asp-for="UsageLimit" type="number" class="form-control" /></div>
        </div>
        <div class="form-check form-switch my-3"><input asp-for="IsActive" class="form-check-input" role="switch" /><label asp-for="IsActive" class="form-check-label">Hoạt động</label></div>
        <button type="submit" class="btn-admin-primary">Cập nhật</button>
        <a asp-action="Index" class="btn-admin-outline">Hủy</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
