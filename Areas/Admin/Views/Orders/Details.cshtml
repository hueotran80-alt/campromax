@model Order
@{
    ViewData["Title"] = "Chi tiết đơn " + Model.OrderCode;
}
<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card">
            <h5>Sản phẩm trong đơn hàng</h5>
            <table class="admin-table">
                <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
                <tbody>
                    @foreach (var d in Model.OrderDetails)
                    {
                        <tr>
                            <td class="cart-product-cell"><img src="@d.ProductImageUrl" class="admin-thumb" /><span>@d.ProductName</span></td>
                            <td>@SlugHelper.FormatVnd(d.UnitPrice)</td>
                            <td>@d.Quantity</td>
                            <td>@SlugHelper.FormatVnd(d.SubTotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="order-total-summary">
                <div class="cart-summary-row"><span>Tạm tính</span><span>@SlugHelper.FormatVnd(Model.SubTotal)</span></div>
                <div class="cart-summary-row"><span>Phí vận chuyển</span><span>@SlugHelper.FormatVnd(Model.ShippingFee)</span></div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="cart-summary-row"><span>Giảm giá</span><span class="text-danger">-@SlugHelper.FormatVnd(Model.DiscountAmount)</span></div>
                }
                <div class="cart-summary-row total-row"><span>Tổng cộng</span><span>@SlugHelper.FormatVnd(Model.TotalAmount)</span></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="admin-card">
            <h5>Thông tin đơn hàng</h5>
            <p><strong>Mã đơn:</strong> @Model.OrderCode</p>
            <p><strong>Khách hàng:</strong> @Model.User?.FullName (@Model.User?.Email)</p>
            <p><strong>Người nhận:</strong> @Model.ReceiverName</p>
            <p><strong>SĐT:</strong> @Model.ReceiverPhone</p>
            <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <p><strong>Ghi chú:</strong> @Model.Note</p>
            }
            <p><strong>Phương thức TT:</strong> @Model.PaymentMethod</p>
            <p><strong>Trạng thái TT:</strong> @(Model.PaymentStatus == PaymentStatus.DaThanhToan ? "Đã thanh toán" : "Chưa thanh toán")</p>
            @if (!string.IsNullOrEmpty(Model.TransactionId))
            {
                <p><strong>Mã giao dịch:</strong> @Model.TransactionId</p>
            }
        </div>
        <div class="admin-card">
            <h5>Cập nhật trạng thái</h5>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                <select name="status" class="form-select mb-3">
                    @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                    {
                        <option value="@((int)s)" selected="@(Model.Status == s)">@DashboardController.OrderStatusText(s)</option>
                    }
                </select>
                <button type="submit" class="btn-admin-primary w-100">Cập nhật trạng thái</button>
            </form>
        </div>
    </div>
</div>
