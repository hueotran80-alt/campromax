@model List<Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}
<div class="admin-card">
    <div class="admin-card-header">
        <form class="admin-filter-form" method="get">
            <input type="text" name="keyword" class="form-control" placeholder="Tìm theo mã đơn, tên, SĐT..." value="@ViewBag.Keyword" />
            <select name="status" class="form-select">
                <option value="">Tất cả trạng thái</option>
                @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                {
                    <option value="@((int)s)" selected="@(ViewBag.Status?.ToString() == s.ToString())">@DashboardController.OrderStatusText(s)</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary">Lọc</button>
        </form>
    </div>
    <table class="admin-table">
        <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td><strong>@o.OrderCode</strong></td>
                    <td>@o.ReceiverName<br /><small class="text-muted">@o.ReceiverPhone</small></td>
                    <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@SlugHelper.FormatVnd(o.TotalAmount)</td>
                    <td>@o.PaymentMethod <br /><small class="@(o.PaymentStatus == PaymentStatus.DaThanhToan ? "text-success" : "text-danger")">@(o.PaymentStatus == PaymentStatus.DaThanhToan ? "Đã thanh toán" : "Chưa thanh toán")</small></td>
                    <td><span class="order-status-badge status-@o.Status">@DashboardController.OrderStatusText(o.Status)</span></td>
                    <td><a asp-action="Details" asp-route-id="@o.Id" class="btn-icon-edit"><i class="bi bi-eye"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
    @if (totalPages > 1)
    {
        <nav class="pagination-wrap">
            <ul class="pagination">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, keyword = ViewBag.Keyword, status = ViewBag.Status })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
