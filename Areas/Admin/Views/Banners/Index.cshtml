@model List<Banner>
@{ ViewData["Title"] = "Quản lý banner"; }
<div class="admin-card">
    <div class="admin-card-header">
        <h5 class="mb-0">Danh sách banner (@Model.Count)</h5>
        <a asp-action="Create" class="btn-admin-primary"><i class="bi bi-plus-lg"></i> Thêm banner</a>
    </div>
    <table class="admin-table">
        <thead><tr><th>Hình</th><th>Tiêu đề</th><th>Thứ tự</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td><img src="@b.ImageUrl" class="admin-thumb-wide" /></td>
                    <td><strong>@b.Title</strong><br /><small class="text-muted">@b.SubTitle</small></td>
                    <td>@b.DisplayOrder</td>
                    <td>@(b.IsActive ? Html.Raw("<span class='badge-status badge-active'>Hiển thị</span>") : Html.Raw("<span class='badge-status badge-inactive'>Đã ẩn</span>"))</td>
                    <td class="admin-actions">
                        <a asp-action="Edit" asp-route-id="@b.Id" class="btn-icon-edit"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@b.Id" method="post" onsubmit="return confirm('Xóa banner này?');">
                            <button type="submit" class="btn-icon-delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
