@model Banner
@{ ViewData["Title"] = "Thêm banner"; }
<div class="admin-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label class="form-label">Tiêu đề</label><input asp-for="Title" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Mô tả phụ</label><input asp-for="SubTitle" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Hình ảnh (URL)</label><input asp-for="ImageUrl" class="form-control" placeholder="/images/banners/ten-anh.jpg" /></div>
        <div class="mb-3"><label class="form-label">Liên kết</label><input asp-for="LinkUrl" class="form-control" placeholder="/san-pham" /></div>
        <div class="mb-3"><label class="form-label">Thứ tự</label><input asp-for="DisplayOrder" type="number" class="form-control" /></div>
        <div class="form-check form-switch mb-3"><input asp-for="IsActive" class="form-check-input" role="switch" /><label asp-for="IsActive" class="form-check-label">Hiển thị</label></div>
        <button type="submit" class="btn-admin-primary">Thêm mới</button>
        <a asp-action="Index" class="btn-admin-outline">Hủy</a>
    </form>
</div>
