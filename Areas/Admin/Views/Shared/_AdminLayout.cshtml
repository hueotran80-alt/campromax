@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
@functions {
    string GetAntiXsrfRequestToken() => Antiforgery.GetAndStoreTokens(Context).RequestToken ?? string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị CamPro Security</title>
    <meta name="csrf-token" content="@GetAntiXsrfRequestToken()" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <a href="/Admin/Dashboard" class="admin-logo"><i class="bi bi-camera-video-fill"></i> CamPro<span>Admin</span></a>
            <nav class="admin-nav">
                <a href="/Admin/Dashboard" class="@(currentController == "Dashboard" ? "active" : "")"><i class="bi bi-speedometer2"></i> Tổng quan</a>
                <a href="/Admin/Products" class="@(currentController == "Products" ? "active" : "")"><i class="bi bi-camera-video"></i> Sản phẩm</a>
                <a href="/Admin/Categories" class="@(currentController == "Categories" ? "active" : "")"><i class="bi bi-grid"></i> Danh mục</a>
                <a href="/Admin/Brands" class="@(currentController == "Brands" ? "active" : "")"><i class="bi bi-award"></i> Thương hiệu</a>
                <a href="/Admin/Orders" class="@(currentController == "Orders" ? "active" : "")"><i class="bi bi-bag-check"></i> Đơn hàng</a>
                <a href="/Admin/Vouchers" class="@(currentController == "Vouchers" ? "active" : "")"><i class="bi bi-ticket-perforated"></i> Voucher</a>
                <a href="/Admin/Reviews" class="@(currentController == "Reviews" ? "active" : "")"><i class="bi bi-star"></i> Đánh giá</a>
                <a href="/Admin/Users" class="@(currentController == "Users" ? "active" : "")"><i class="bi bi-people"></i> Khách hàng</a>
                <a href="/Admin/Banners" class="@(currentController == "Banners" ? "active" : "")"><i class="bi bi-images"></i> Banner</a>
                <a href="/Admin/News" class="@(currentController == "News" ? "active" : "")"><i class="bi bi-newspaper"></i> Tin tức</a>
                <hr />
                <a href="/"><i class="bi bi-box-arrow-left"></i> Về trang bán hàng</a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="admin-logout-btn"><i class="bi bi-power"></i> Đăng xuất</button>
                </form>
            </nav>
        </aside>
        <div class="admin-main">
            <header class="admin-topbar">
                <button id="sidebarToggle" class="sidebar-toggle-btn"><i class="bi bi-list"></i></button>
                <h4>@ViewData["Title"]</h4>
                <div class="admin-topbar-user"><i class="bi bi-person-circle"></i> @User.Identity?.Name</div>
            </header>
            <main class="admin-content">
                @{
                    var successMsg = TempData["Success"] as string;
                    var errorMsg = TempData["Error"] as string;
                }
                @if (!string.IsNullOrEmpty(successMsg))
                {
                    <div class="alert alert-success alert-dismissible fade show">@successMsg<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @if (!string.IsNullOrEmpty(errorMsg))
                {
                    <div class="alert alert-danger alert-dismissible fade show">@errorMsg<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
